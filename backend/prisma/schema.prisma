generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid(7)) @db.Uuid
  email String? @unique
  emailVerifiedAt DateTime?
  phone String? @unique
  phoneVerifiedAt DateTime?
  googleId String? @unique
  telegramId String? @unique
  name String?
  password String?
  preferredChannel String?
  pushToken String?

   latitude Decimal?
    longitude Decimal?

  master MasterProfile?
  ordersAsCustomer Order[]

  urgentOffer UrgentOffer[]

  filedComplaints  Complaint[] @relation("ClientComplaints")
}

model MasterProfile {
     id String @id  @default(uuid(7)) @db.Uuid
    userId String @unique @db.Uuid
    user User @relation(fields: [userId], references: [id])

    speciality MasterSpecialty
    description String?
    documents MasterDocument[]
    photoUrl String?
    photoPublicId String?
    rating Float?

    instagram String?
    facebook String?
    youtube String?

    agreedToTerms Boolean @default(false)
    dateAgreeToTerms DateTime

    minPrice Int?
    maxPrice Int?

    schedules MasterSchedule[]
    breaks  ScheduleBreak[]
    timeBlocks TimeBlock[]
    serviceAreas ServiceArea[]

    orders Order[]
    isActive Boolean@default(false)

    complaints Complaint[]

    urgentOffers OfferMaster[]

    @@index([minPrice, maxPrice])
}


model Order {
 id String @id @default(uuid(7)) @db.Uuid
 customerId String @db.Uuid
 masterId String @db.Uuid

 description String?
 photo OrderPhoto[]
 postalCode String
 status OrderStatus @default(CREATED)

 cancelledReason String?
 dataCancelled DateTime?
 cancelledById String?

 customerCompleteddAt DateTime?
 masterCompleteddAt DateTime?

 customerHiddenAt DateTime?
 masterHiddenAt   DateTime?

 customer User @relation(fields: [customerId], references: [id])
 master MasterProfile @relation(fields: [masterId], references: [id])

timeBlock  TimeBlock?
createdAt DateTime @default(now())

complaint   Complaint?
}


enum OrderStatus {
  CREATED
  BOOKING
  CONFIRMED
  PROPOSED
  CLIENT_CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  EXPIRED
}


 enum MasterSpecialty {
  ELECTRICIAN
  PLUMBER
  WASHING_MACHINE
  REFRIGERATOR
  TV_REPAIR
  COMPUTER
  MOBILE
  CARPENTER
  PAINTER
  BUILDER
  LOCKSMITH
  HEATING
  AIR_CONDITIONING
  GAS_TECHNICIAN
  AUTO_ELECTRICIAN
  HAIRDRESSER
  MANICURE
  NURSE
  TEACHER
  HOUSEKEEPER
  COOK
  GARDENER
}

model MasterSchedule {
    id String @id @default(uuid(7)) @db.Uuid
    masterId String @db.Uuid
    master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

    dayOfWeek DayOfWeek
    isWorking Boolean @default(false)
    startTime  String
    endTime String

   @@unique([masterId, dayOfWeek])
}

model TimeBlock {
id String @id @default(uuid(7)) @db.Uuid

masterId String @db.Uuid
master MasterProfile @relation(fields: [masterId], references: [id])

startAt DateTime?  @db.Timestamptz(3)
endAt DateTime?  @db.Timestamptz(3)
status TimeBlockStatus
reservationMinutes Int?
reservationExpiresAt DateTime?  @db.Timestamptz(3)


orderId String? @unique @db.Uuid
order Order?  @relation(fields: [orderId], references: [id])

offerMasterId String? @unique @db.Uuid
offerMaster OfferMaster? @relation(fields: [offerMasterId], references: [id])

reason TimeBlockReason?
}

enum TimeBlockReason {
  ORDER
  PERSONAL
  BREAK
  DAY_OFF
  OTHER
  OFFER
}

enum TimeBlockStatus {
  RESERVED
  BLOCKED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ScheduleBreak {
  id String @id @default(uuid(7)) @db.Uuid
  masterId   String @db.Uuid
  master     MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  startTime String
  endTime String
  type BreakType
  recurrence String
}

enum BreakType {
  LUNCH
  WORKSHOP
  PERSONAL
  OTHER
}

model ServiceArea {
  id String @id @default(uuid(7)) @db.Uuid
 name String
 postalCode String
 radius Float?

  masterId String @db.Uuid
  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, postalCode, name])
  @@index([postalCode])
  @@index([masterId, name])
}

model MasterDocument {
  id String @id @default(uuid(7)) @db.Uuid
  fileName String
  fileUrl String
  filePublicId String
  mimeType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterId String @db.Uuid
  master MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

   @@index([masterId])
}


model OrderPhoto {
  id String @id @default(uuid(7)) @db.Uuid
  fileName String
  fileUrl String
  filePublicId String
  mimeType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  urgentOfferId String? @db.Uuid
  urgentOffer UrgentOffer? @relation(fields: [urgentOfferId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ZipCodeDirectory {
  postalCode String @id
  cityName   String
  latitude   Float
  longitude  Float

  @@index([latitude, longitude])
}

model Complaint {
  id              String        @id @default(uuid(7)) @db.Uuid
  orderId         String        @unique @db.Uuid
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clientId        String        @db.Uuid
  client          User          @relation("ClientComplaints", fields: [clientId], references: [id])
  masterProfileId String        @db.Uuid
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  reason          String
  description     String?       @db.VarChar(1000)
  createdAt       DateTime      @default(now())

  @@index([masterProfileId])
   @@index([clientId])
}

model UrgentOffer {
  id String @id @default(uuid(7)) @db.Uuid
  customerId String @db.Uuid

  description String?
  photo OrderPhoto[]
  postalCode String
  status UrgentStatus @default(CREATED)

  customer User @relation(fields: [customerId], references: [id])
  offers OfferMaster[]

  createdAt DateTime @default(now())

  cancelledReason String?
  cancelledAt DateTime?
}

model OfferMaster {
  id String @id @default(uuid(7)) @db.Uuid
  urgentOfferId String @db.Uuid
  masterId String @db.Uuid

  status MasterOfferStatus @default(SEND)
  timeBlock  TimeBlock?
  rejectedReason String?

  urgentOffer UrgentOffer @relation(fields: [urgentOfferId], references: [id], onDelete: Cascade)
  master MasterProfile @relation(fields: [masterId], references: [id])

  sendAt DateTime @default(now())
  respondedAt   DateTime?

  @@unique([urgentOfferId, masterId])
  @@index([masterId, status])
}

enum UrgentStatus {
  CREATED
  SEARCHING
  MASTER_SELECTED
  CANCELED
  EXPIRED
}

enum MasterOfferStatus {
  SEND
  ACCEPTED
  REJECTED
  EXPIRED
}
